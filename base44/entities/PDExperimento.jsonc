{
  "name": "PDExperimento",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "Título do experimento de P&D (teste de PR do construtor)."
    },
    "resultado": {
      "type": "string",
      "description": "Resultado do experimento."
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "pd"
          }
        },
        {
          "user_condition": {
            "role": "rh"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "pd"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
