{
  "name": "RHColaborador",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do colaborador (dado de RH, fictício)."
    },
    "salario": {
      "type": "number",
      "description": "Salário (fictício)."
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "rh"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "rh"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "rh"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
